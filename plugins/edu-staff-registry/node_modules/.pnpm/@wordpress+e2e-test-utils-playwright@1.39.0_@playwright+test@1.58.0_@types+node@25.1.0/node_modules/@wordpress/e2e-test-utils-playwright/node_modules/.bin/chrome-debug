#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspaces/my-wp-2026/plugins/edu-staff-registry/node_modules/.pnpm/lighthouse@12.8.2/node_modules/lighthouse/core/scripts/node_modules:/workspaces/my-wp-2026/plugins/edu-staff-registry/node_modules/.pnpm/lighthouse@12.8.2/node_modules/lighthouse/core/node_modules:/workspaces/my-wp-2026/plugins/edu-staff-registry/node_modules/.pnpm/lighthouse@12.8.2/node_modules/lighthouse/node_modules:/workspaces/my-wp-2026/plugins/edu-staff-registry/node_modules/.pnpm/lighthouse@12.8.2/node_modules:/workspaces/my-wp-2026/plugins/edu-staff-registry/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspaces/my-wp-2026/plugins/edu-staff-registry/node_modules/.pnpm/lighthouse@12.8.2/node_modules/lighthouse/core/scripts/node_modules:/workspaces/my-wp-2026/plugins/edu-staff-registry/node_modules/.pnpm/lighthouse@12.8.2/node_modules/lighthouse/core/node_modules:/workspaces/my-wp-2026/plugins/edu-staff-registry/node_modules/.pnpm/lighthouse@12.8.2/node_modules/lighthouse/node_modules:/workspaces/my-wp-2026/plugins/edu-staff-registry/node_modules/.pnpm/lighthouse@12.8.2/node_modules:/workspaces/my-wp-2026/plugins/edu-staff-registry/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../../lighthouse@12.8.2/node_modules/lighthouse/core/scripts/manual-chrome-launcher.js" "$@"
else
  exec node  "$basedir/../../../../../../lighthouse@12.8.2/node_modules/lighthouse/core/scripts/manual-chrome-launcher.js" "$@"
fi
