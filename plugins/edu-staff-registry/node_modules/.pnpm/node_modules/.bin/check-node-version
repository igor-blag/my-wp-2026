#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspaces/my-wp-2026/plugins/edu-staff-registry/node_modules/.pnpm/check-node-version@4.2.1/node_modules/check-node-version/node_modules:/workspaces/my-wp-2026/plugins/edu-staff-registry/node_modules/.pnpm/check-node-version@4.2.1/node_modules:/workspaces/my-wp-2026/plugins/edu-staff-registry/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspaces/my-wp-2026/plugins/edu-staff-registry/node_modules/.pnpm/check-node-version@4.2.1/node_modules/check-node-version/node_modules:/workspaces/my-wp-2026/plugins/edu-staff-registry/node_modules/.pnpm/check-node-version@4.2.1/node_modules:/workspaces/my-wp-2026/plugins/edu-staff-registry/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../check-node-version/bin.js" "$@"
else
  exec node  "$basedir/../check-node-version/bin.js" "$@"
fi
