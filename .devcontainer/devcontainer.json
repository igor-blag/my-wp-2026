{
    "name": "WordPress Modern Dev Environment",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "resolvedev.mysql-client",
                "dsznajder.es7-react-js-snippets"
            ]
        }
    },
    // Auto-forward port 80 to access the web server
    "forwardPorts": [80],
    
    // Setup script runs once after container creation
    "postCreateCommand": "bash .devcontainer/setup.sh",

    // Start services every time the container starts
    "postStartCommand": "sudo service apache2 start && sudo service mysql start",

    "remoteUser": "vscode"
}