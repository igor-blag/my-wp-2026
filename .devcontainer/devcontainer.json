{
    "name": "WordPress Dev Environment 2026",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "resolvedev.mysql-client"
            ]
        }
    },
    // Пробрасываем порт 80 автоматически
    "forwardPorts": [80],
    
    // Эта команда выполняется ОДИН РАЗ, когда контейнер создан
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "postStartCommand": "sudo service apache2 start && sudo service mysql start",

    // Настройка прав для пользователя
    "remoteUser": "vscode"
}